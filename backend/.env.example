# --- Core database and session ---
# Docker Compose 使用服务名 postgres；本机直接运行 uvicorn 时改为 127.0.0.1。
CORE_DATABASE_URL=postgresql+psycopg://langear:langear@postgres:5432/langear
# At least 32 characters. Never commit a real value.
CORE_CONFIRMATION_SECRET=replace-with-a-random-secret-of-32-chars
CORE_ALLOWED_ORIGINS=["http://localhost:3002"]
CORE_COOKIE_SECURE=false

# --- Uploads and OSS ---
CORE_UPLOAD_PREFIX=dev/local
CORE_OSS_ACCESS_KEY_ID=your_access_key_id_here
CORE_OSS_ACCESS_KEY_SECRET=your_access_key_secret_here
CORE_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
CORE_OSS_BUCKET_NAME=your_bucket_name

# --- AI feedback provider ---
CORE_AI_FEEDBACK_PROVIDER=gemini
CORE_AI_FEEDBACK_PROMPT_VERSION=v1

# Google Gemini through the official google-genai SDK.
CORE_GEMINI_API_KEY=your_gemini_api_key_here
CORE_GEMINI_MODEL_ID=gemini-3.8-flash
# Per-request timeout in milliseconds; keeps a stalled request from blocking the outbox worker.
CORE_GEMINI_REQUEST_TIMEOUT_MS=180000
# Optional relay endpoint for the official SDK.
# GOOGLE_GEMINI_BASE_URL=

# Alibaba Cloud Qwen Omni feedback. Select it with CORE_AI_FEEDBACK_PROVIDER=qwen_omni.
CORE_QWEN_OMNI_API_KEY=
CORE_QWEN_OMNI_MODEL_ID=qwen3.8-omni-flash
CORE_QWEN_OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- ASR (qwen3-asr-flash through DashScope) ---
CORE_ASR_API_KEY=your_dashscope_api_key_here
CORE_REALTIME_ASR_PROVIDER=dashscope
CORE_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime
CORE_REALTIME_ASR_LANGUAGE=en

# --- Dialogue agent ---
CORE_DIALOGUE_ENABLED=false
CORE_DIALOGUE_AGENT_URL=http://127.0.0.1:8111
# CORE_DIALOGUE_AGENT_TOKEN=
# CORE_DIALOGUE_API_KEY=
# CORE_DIALOGUE_MODEL=
# CORE_DIALOGUE_VOICE=
# CORE_DIALOGUE_WS_URL=
