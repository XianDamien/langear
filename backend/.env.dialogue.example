# Merge into the isolated core backend's private environment, never frontend env.
CORE_DIALOGUE_ENABLED=true
CORE_DIALOGUE_AGENT_URL=http://agent:8111
# Must equal AGENT_SERVICE_TOKEN; use a random value of at least 32 characters.
CORE_DIALOGUE_AGENT_TOKEN=
CORE_DIALOGUE_API_KEY=
CORE_DIALOGUE_MODEL=qwen3.8-omni-flash-realtime
# Match the API key's region and business workspace. This is the classic Beijing endpoint.
CORE_DIALOGUE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
CORE_DIALOGUE_ASR_MODEL=qwen3-asr-flash-realtime
CORE_DIALOGUE_VOICE=Tina
